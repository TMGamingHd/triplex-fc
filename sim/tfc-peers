"""Launcher for the virtual peers that works from any directory:  /path/to/sim/tfc-peers listen ...

(`python3 -m tfc_peers ...` only works from inside sim/, because that is where the package lives.)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from tfc_peers.cli import main  # noqa: E402

sys.exit(main())
