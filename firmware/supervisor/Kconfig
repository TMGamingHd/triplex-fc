mainmenu "Supervisor (Pico 2, SUP-Lite)"

config TFC_USB_VID
	hex "USB vendor id"
	default 0x1209
	help
	  The pid.codes open vendor id, for a private bench device. Nothing here is for sale or for the field.

config TFC_USB_PID
	hex "USB product id"
	default 0x0002

config TFC_WATCHDOG_TIMEOUT_MS
	int "Hardware watchdog timeout (milliseconds)"
	default 100
	range 20 4000
	help
	  A supervisor that hangs resets itself and comes back with every output at its default and a warm start (it adopts running units and touches nothing).

config TFC_OVERRIDE_LINES_FITTED
	hex "Which hardware-override sense lines are wired (bit 0 H1 E-stop .. bit 5 H6/H7 node power-kill)"
	default 0x0
	range 0 0x3F
	help
	  The overrides' parts are ordered separately (docs/HARDWARE_OVERRIDE.md section 8). A line that is not wired is ignored; with none wired the feature is inert. A wired line that is engaged
	  blocks `launch` and `t0` until the operator types `override-ok`; the sense lines never change what the supervisor does to a unit (TFC-HWO-005).

source "Kconfig.zephyr"
