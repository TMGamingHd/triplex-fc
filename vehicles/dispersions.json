// A starting set of dispersions for tfc_mc (docs/design/MONTE_CARLO.md). EVERY NUMBER IS AN ASSUMPTION about a generic launcher, written from the usual orders of magnitude of launch-vehicle
// dispersion analyses, not taken from any vehicle or measured: replace them with the ones your vehicle has. Exception: the sensors, which are the ISM330DHCX's own (DS13012 rev 7, Table 3, the
// typical values, "sensor_preset": see docs/design/IMU_MODEL.md): zero-rate level +-1 dps, zero-g offset +-10 mg, sensitivity +-2 %, cross-axis 1 % and 0.5 %, a white noise of 5 mdps and 60 micro-g per
// root hertz, a bias instability of 3 degrees an hour, drift with temperature; the temperature and the sample jitter below are assumptions.
// "sensor_preset": "bench" (the first weeks' uniform noise and no errors), "ism330dhcx_typical" or "ism330dhcx_maximum" (the datasheet's limits).
// "normal": [mean, standard deviation(, clip in standard deviations; 3 if not given)]; "uniform": [min, max]; "constant": a number.
{
  "flights": 100,
  "seed": 1,
  "limit_deg": 5,
  "sensor_preset": "ism330dhcx_typical",
  "dispersions": [
    {"name": "thrust_scale", "normal": [1.0, 0.01]},
    {"name": "isp_scale", "normal": [1.0, 0.005]},
    {"name": "cd_scale", "normal": [1.0, 0.1]},
    {"name": "cn_scale", "normal": [1.0, 0.1]},
    {"name": "thrust_misalign_pitch_deg", "normal": [0, 0.15]},
    {"name": "thrust_misalign_yaw_deg", "normal": [0, 0.15]},
    {"name": "gimbal_lag_s", "uniform": [0, 0.05]},
    {"name": "dry_mass_scale", "normal": [1.0, 0.02]},
    {"name": "propellant_scale", "normal": [1.0, 0.005]},
    {"name": "dry_cg_shift_m", "normal": [0, 0.15]},
    {"name": "wind_scale", "uniform": [0, 2]},
    {"name": "wind_azimuth_deg", "uniform": [0, 360]},
    {"name": "turbulence_sigma_ms", "uniform": [0, 3]},
    {"name": "density_scale", "normal": [1.0, 0.05]},
    {"name": "temperature_offset_k", "normal": [0, 5]},
    {"name": "sensor_temperature_offset_c", "uniform": [-20, 40]},
    {"name": "sample_jitter", "uniform": [0, 0.3]}
  ]
}
