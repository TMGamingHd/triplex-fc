// The two-stage launcher of two_stage_launcher.json with the dynamics of DYNAMICS.md switched on: a second-order gimbal servo with backlash, jet damping, a roll controller, sloshing in
// every tank, one bending mode of the first stage, and the push and tip-off of the stage separation. EVERY NUMBER OF THE DYNAMICS HERE IS AN ASSUMPTION, none is measured or taken from a
// vehicle: it shows what the simulator does with them and what the flight software makes of the result. Fly it as the other: tfc_fly vehicles/launcher_dynamics.json --sensors vehicle --no-accel.
{
  "name": "two-stage launcher with dynamics",
  "description": "The two-stage launcher with a second-order servo, backlash, jet damping, a roll controller, slosh, one bending mode and a separation that pushes and twists (all assumed numbers).",
  "vehicle": {"gimbal_limit_deg": 5, "gimbal_rate_dps": 20, "ideal_roll_control": false},
  "actuator": {"order": 2, "natural_hz": 6, "damping": 0.6, "backlash_deg": 0.1},
  "jet_damping": true,
  "roll_control": {"stage": 1, "torque_max_nm": 60000, "kp_nm_per_rad": 100000, "kd_nm_s_per_rad": 500000},
  "flex": {"stage": 0, "frequency_hz": 2.5, "damping": 0.005, "generalized_mass_kg": 40000, "phi_engine": 1.0, "slope_engine_per_m": 0.05, "phi_imu": 0.3, "slope_imu_per_m": -0.04},
  "aero": {"diameter_m": 3.7},   // the aerodynamics follow the shape (the stages' sections and the fairing's); diameter_m is the reference model's and is not used
  "stages": [
    {"name": "first", "dry_mass_kg": 22000, "x_start_m": 0, "length_m": 46, "radius_m": 1.85, "inertia_factor": 0.6, "x_cg_dry_m": 20,
     "tanks": [
       {"propellant_kg": 130000, "x_bottom_m": 2, "radius_m": 1.8, "density_kg_m3": 810, "slosh": {"damping": 0.03}},     // kerosene, low
       {"propellant_kg": 280000, "x_bottom_m": 18.5, "radius_m": 1.8, "density_kg_m3": 1140, "slosh": {"damping": 0.03}}  // liquid oxygen, above it
     ],
     "sections": [{"kind": "tube", "x_start_m": 0, "length_m": 46, "d_aft_m": 3.7, "d_fore_m": 3.7}],
     "separate_on_burnout": true, "separate_delay_s": 2.0, "separation_dv_ms": 1.5, "tipoff_pitch_dps": 0.2, "tipoff_yaw_dps": -0.1, "tipoff_roll_dps": 0.3,
     "throttle": [[0, 1.0], [55, 1.0], [65, 0.7], [85, 0.7], [95, 1.0]]},   // thrust against time since ignition: down through max-Q
    {"name": "second", "dry_mass_kg": 4000, "x_start_m": 46, "length_m": 14, "radius_m": 1.85, "inertia_factor": 0.6, "x_cg_dry_m": 52,
     "tanks": [
       {"propellant_kg": 30000, "x_bottom_m": 47, "radius_m": 1.8, "density_kg_m3": 810, "slosh": {"damping": 0.03}},
       {"propellant_kg": 80000, "x_bottom_m": 51, "radius_m": 1.8, "density_kg_m3": 1140, "slosh": {"damping": 0.03}}
     ],
     "sections": [{"kind": "tube", "x_start_m": 46, "length_m": 14, "d_aft_m": 3.7, "d_fore_m": 3.7}],
     "ignite_after_sep_of": 0, "ignite_delay_s": 4.0, "gimbal_limit_deg": 5, "gimbal_rate_dps": 20}
  ],
  "engines": [
    // nine on the first stage: one in the middle, eight on a circle of 1.2 m; thrust and exit area per engine
    {"stage": 0, "count": 1, "position_m": [0, 0, 0], "thrust_vac_n": 900000, "exit_area_m2": 0.9, "isp_vac_s": 311, "rise_s": 0.3, "tail_s": 0.5},
    {"stage": 0, "count": 8, "position_m": [0, 0, 0], "ring_radius_m": 1.2, "thrust_vac_n": 900000, "exit_area_m2": 0.9, "isp_vac_s": 311, "rise_s": 0.3, "tail_s": 0.5},
    // one vacuum engine on the second stage
    {"stage": 1, "position_m": [46, 0, 0], "thrust_vac_n": 930000, "exit_area_m2": 4.0, "isp_vac_s": 348, "rise_s": 0.5, "tail_s": 0.5}
  ],
  "payloads": [
    {"name": "fairing", "mass_kg": 1900, "x_m": 66, "jettison_time_s": 210,
     "sections": [{"kind": "nose", "x_start_m": 60, "length_m": 12, "d_aft_m": 3.7, "d_fore_m": 0, "shape": "ogive"}]},   // the nose of the vehicle: it leaves with the fairing, and the vehicle ends in a flat face
    {"name": "payload", "mass_kg": 15000, "x_m": 63}
  ],
  "design": {"t_end_s": 400, "vertical_s": 12, "kick_ramp_s": 6, "kick_deg": 1.5, "follow_from_s": 30, "blend_s": 8,
             "gains": {"every_s": 0, "wn": 1.2, "zeta": 0.8, "ki_over_kp": 0.2, "b_min": 0.05}}
}
